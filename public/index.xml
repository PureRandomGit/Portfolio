    <item>
      <title>Gallery</title>
      <link>http://localhost:44697/gallery/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>http://localhost:44697/gallery/</guid>
      <description>&lt;style&gt;
  .gallery-grid {
      display: grid;
       
      grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
      gap: 20px;
      margin: 2rem 0;
      max-width: 100%;
  }

   
  @media (max-width: 540px) {
      .gallery-grid {
          grid-template-columns: repeat(2, 1fr);
          gap: 10px;  
      }
  }

  .gallery-img {
      width: 100%;
      aspect-ratio: 1/1; 
      object-fit: cover;
      border-radius: 12px; 
      border: none; 
      cursor: pointer;
       
      box-shadow: 0 4px 10px rgba(0, 0, 0, 0.15);
      transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

   
  .dark .gallery-img {
      box-shadow: 0 4px 10px rgba(255, 255, 255, 0.15);
  }

  .gallery-img:hover {
      transform: scale(1.03); 
       
      box-shadow: 0 8px 20px rgba(0, 0, 0, 0.25);
  }

  .dark .gallery-img:hover {
      box-shadow: 0 8px 20px rgba(255, 255, 255, 0.25);
  }

  #lightbox {
      border: none;
      padding: 0;
      max-width: 90vw;
      max-height: 90vh;
      background: var(--theme);
      color: var(--primary);
       
      box-shadow: 0 10px 40px rgba(0, 0, 0, 0.5);
      overflow: hidden;
  }

  .dark #lightbox {
       
      box-shadow: 0 10px 40px rgba(255, 255, 255, 0.15);
  }

  #lightbox::backdrop {
      background: rgba(0, 0, 0, 0.5);
      backdrop-filter: blur(3px);
  }

  .lightbox-content {
      margin-top: 0px;
      display: flex;
      flex-direction: column;
      position: relative;
      margin-bottom: 0px;
      max-height: 90vh;
  }

  #lightbox-img {
      margin-top: 0px;
      margin-bottom: 0px;;
      max-width: 100%;
      max-height: 80vh;
      object-fit: contain;
      display: block;
      border-radius: 0;
  }

  #lightbox-desc {
      padding: 5px 5px;
      font-size: 1.3rem;
      text-align: center;
      background: var(--theme);
      border-radius: 0px 0px 8px 8px;
      width: calc(100% - 4px);
      height: calc(100% - 2px);
      margin-bottom: 5px;
      margin-left: 2px;
      outline: 2px solid var(--primary);
  }

  .close-btn {
      position: absolute;
      top: 10px;
      right: 15px;
      color: white;
      cursor: pointer;
      background: rgba(0,0,0,0.5);
      border: none;
      border-radius: 50%;
      width: 40px;
      height: 40px;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: background 0.2s;
  }

  .close-btn:hover {
      background: rgba(0,0,0,0.8);
  }
&lt;/style&gt;

&lt;div class=&#34;gallery-grid&#34;&gt;&lt;img src=&#34;http://localhost:44697/gallery/WaterPig_hu_d1ecc09d6dcd7048.webp&#34; alt=&#34;Water Pig Front&#34; data-title=&#34;Water Pig Front&#34; data-desc=&#34;Render of Exploding Bacon&amp;#39;s 2025 Robot WaterPig, made in Blender.&#34; data-link=&#34;&#34; data-full=&#34;/gallery/WaterPig.png&#34; class=&#34;gallery-img&#34; onclick=&#34;openLightbox(this)&#34; loading=&#34;lazy&#34;&gt;&lt;img src=&#34;http://localhost:44697/gallery/WaterPigSideBlack_hu_b2ae9d1416fa422a.webp&#34; alt=&#34;Water Pig&#34; data-title=&#34;Water Pig&#34; data-desc=&#34;Render of Exploding Bacon&amp;#39;s 2025 Robot WaterPig, made in Blender.&#34; data-link=&#34;&#34; data-full=&#34;/gallery/WaterPigSideBlack.png&#34; class=&#34;gallery-img&#34; onclick=&#34;openLightbox(this)&#34; loading=&#34;lazy&#34;&gt;&lt;img src=&#34;http://localhost:44697/gallery/WaterPigSideWhite_hu_a1add104369235af.webp&#34; alt=&#34;Water Pig&#34; data-title=&#34;Water Pig&#34; data-desc=&#34;Render of Exploding Bacon&amp;#39;s 2025 Robot WaterPig, made in Blender.&#34; data-link=&#34;&#34; data-full=&#34;/gallery/WaterPigSideWhite.png&#34; class=&#34;gallery-img&#34; onclick=&#34;openLightbox(this)&#34; loading=&#34;lazy&#34;&gt;&lt;img src=&#34;http://localhost:44697/gallery/duck_hu_569632dd8c4cedae.webp&#34; alt=&#34;Duck Launcher&#34; data-title=&#34;Duck Launcher&#34; data-desc=&#34;Render of the Duck Launcher for UCF EGN1006C, made in Blender&#34; data-link=&#34;/posts/duck-launcher/&#34; data-full=&#34;/gallery/duck.webp&#34; class=&#34;gallery-img&#34; onclick=&#34;openLightbox(this)&#34; loading=&#34;lazy&#34;&gt;&lt;img src=&#34;http://localhost:44697/gallery/porkestra_hu_f3da7ef52c9b84d4.webp&#34; alt=&#34;Porkestra&#34; data-title=&#34;Porkestra&#34; data-desc=&#34;Render of Exploding Bacon&amp;#39;s 2024 Robot WaterPig, made in Blender, environment is 3d scanned.&#34; data-link=&#34;&#34; data-full=&#34;/gallery/porkestra.png&#34; class=&#34;gallery-img&#34; onclick=&#34;openLightbox(this)&#34; loading=&#34;lazy&#34;&gt;
&lt;/div&gt;

&lt;dialog id=&#34;lightbox&#34;&gt;
  &lt;div class=&#34;lightbox-content&#34;&gt;
    &lt;button class=&#34;close-btn&#34; onclick=&#34;closeLightbox()&#34; aria-label=&#34;Close Lightbox&#34;&gt;
    &lt;svg xmlns=&#34;http://www.w3.org/2000/svg&#34; width=&#34;24&#34; height=&#34;24&#34; viewBox=&#34;0 0 24 24&#34; fill=&#34;none&#34; stroke=&#34;currentColor&#34; stroke-width=&#34;2&#34; stroke-linecap=&#34;round&#34; stroke-linejoin=&#34;round&#34;&gt;
        &lt;line x1=&#34;18&#34; y1=&#34;6&#34; x2=&#34;6&#34; y2=&#34;18&#34;&gt;&lt;/line&gt;
        &lt;line x1=&#34;6&#34; y1=&#34;6&#34; x2=&#34;18&#34; y2=&#34;18&#34;&gt;&lt;/line&gt;
    &lt;/svg&gt;
    &lt;/button&gt;    
    &lt;img id=&#34;lightbox-img&#34; src=&#34;&#34; alt=&#34;Full size image&#34;&gt;
    &lt;div id=&#34;lightbox-desc&#34;&gt;&lt;/div&gt;
  &lt;/div&gt;
&lt;/dialog&gt;

&lt;script&gt;
  const lightbox = document.getElementById(&#39;lightbox&#39;);
  const lightboxImg = document.getElementById(&#39;lightbox-img&#39;);
  const lightboxDesc = document.getElementById(&#39;lightbox-desc&#39;);

  function openLightbox(imgElement) {
      
      lightboxImg.src = imgElement.getAttribute(&#39;data-full&#39;);
      
      let titleText = imgElement.getAttribute(&#39;data-title&#39;);
      let descText = imgElement.getAttribute(&#39;data-desc&#39;);
      let linkUrl = imgElement.getAttribute(&#39;data-link&#39;);

      
      let contentHtml = `&lt;span style=&#34;font-weight: bold; font-family: Roboto;&#34;&gt;${titleText}&lt;/span&gt;`;

      
      if (descText) {
          contentHtml += `&lt;br&gt;&lt;span style=&#34;font-size: 0.9em; font-family: Roboto; opacity: 0.9;&#34;&gt;${descText}&lt;/span&gt;`;
      }

      
      if (linkUrl) {
          contentHtml += `&lt;br&gt;&lt;a href=&#34;${linkUrl}&#34; style=&#34;color: var(--primary); text-decoration: underline; margin-top: 8px; display: inline-block; font-family: Roboto;&#34;&gt;Read the full article&lt;/a&gt;`;
      }

      
      lightboxDesc.innerHTML = contentHtml;
      lightbox.showModal();
  }

  function closeLightbox() {
      lightbox.close();
  }

  lightbox.addEventListener(&#39;click&#39;, (e) =&gt; {
      const dialogDimensions = lightbox.getBoundingClientRect();
      if (
          e.clientX &lt; dialogDimensions.left ||
          e.clientX &gt; dialogDimensions.right ||
          e.clientY &lt; dialogDimensions.top ||
          e.clientY &gt; dialogDimensions.bottom
      ) {
          closeLightbox();
      }
  });
&lt;/script&gt;</description>
